APP_NAME=Laravel
APP_ENV=local
# APP_KEY se genera con `php artisan key:generate`
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost
# Opcional en producción; si se define, conserva sólo los dominios operativos.
# TRUSTED_HOSTS=caope.ayudafesi.com,xocoyotzin.iztacala.unam.mx

# Antes de desplegar producción: APP_ENV=production, APP_DEBUG=false y APP_KEY válida.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging configuration (daily rotation by default)
LOG_CHANNEL=stack
# Comma separated list of channels to include in the stack (daily rotates files)
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Minimum severity logged by the channels above
LOG_LEVEL=debug
# Number of days to keep daily log files
# LOG_DAILY_DAYS=14

# Database connection (SQLite default for local development)
DB_CONNECTION=sqlite
# SQLite usa un archivo dentro de database/
DB_DATABASE=database/database.sqlite
# Para producción usar MySQL y descomentar las variables siguientes.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DUMP_SKIP_SSL=false

# Cache configuration (file driver by default)
CACHE_STORE=file
# CACHE_PREFIX=
# CACHE_CATALOGOS_STORE=
# CACHE_CATALOGOS_TAGS=catalogos
# CACHE_CATALOGOS_TTL=3600
# DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks

# Queue configuration (sync driver in local & prod by default)
QUEUE_CONNECTION=sync
# Para producción sin workers dedicados mantenlo en `sync`. Si habilitas workers,
# cambia a `database` y ajusta la conexión/tables.
# DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
# QUEUE_FAILED_DRIVER=database-uuids

# Session storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Usa true tanto en pruebas HTTPS como en producción. En producción es el valor predeterminado.
SESSION_SECURE_COOKIE=false

# Obligatoria en servidores desplegados. Usa 32 o más caracteres, un secreto distinto de APP_KEY y no lo versionés.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Retención de datos operativos sensibles
SECURITY_EXPORT_RETENTION_HOURS=2
SECURITY_BACKUP_RESTORE_ARTIFACT_RETENTION_DAYS=30
SECURITY_READ_NOTIFICATION_RETENTION_DAYS=30
SECURITY_NOTIFICATION_RETENTION_DAYS=90
SECURITY_PASSWORD_RESET_RETENTION_HOURS=2
SECURITY_FAILED_JOB_RETENTION_DAYS=7
SECURITY_JOB_BATCH_RETENTION_DAYS=7
SECURITY_SESSION_GRACE_MINUTES=1440

# Broadcasting
BROADCAST_CONNECTION=log

# Default filesystem disk (local, public, s3...)
FILESYSTEM_DISK=public
FILESYSTEM_DISK_PRIVATE=private

# In-memory cache hosts (optional)
MEMCACHED_HOST=127.0.0.1

# Redis connection (optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail transport configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
# MAIL_URL=
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS integration (used by some optional services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Consola técnica y despliegues (deshabilitada de forma predeterminada)
DEVELOPER_CONSOLE_ENABLED=false
# Lista opcional de IPs separadas por coma. Vacío permite cualquier IP autenticada.
DEVELOPER_CONSOLE_ALLOWED_IPS=
DEVELOPER_CONSOLE_PASSWORD_TIMEOUT=900
DEVELOPER_CONSOLE_TARGET_LABEL=producción
# Compatibilidad con staging legado. La activación web de producción no lo usa.
DEVELOPER_CONSOLE_DEPLOY_WEBHOOK_TOKEN=
# Ruta opcional; por defecto se usa scripts/deploy-scheduled.sh en la raíz del repositorio.
DEVELOPER_CONSOLE_DEPLOY_SCRIPT=
DEVELOPER_CONSOLE_GITHUB_API_URL=https://api.github.com
DEVELOPER_CONSOLE_GITHUB_REPOSITORY=Sciosdev/caope
DEVELOPER_CONSOLE_GITHUB_WORKFLOW=deploy.yml
DEVELOPER_CONSOLE_GITHUB_REF=main
# Token fine-grained con Actions: Read and write. Nunca se versiona el valor real.
DEVELOPER_CONSOLE_GITHUB_TOKEN=
